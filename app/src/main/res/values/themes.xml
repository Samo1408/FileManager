<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FileManager" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/filemanager_window_background</item>
    </style>

    <style name="Theme.FileManager.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/filemanager_seed</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.FileManager</item>
    </style>
</resources>
